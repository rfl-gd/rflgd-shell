{
  "name": "@reflagged/shell",
  "version": "1.11.1",
  "description": "Shared app shell for Reflagged services — OIDC auth, SSO, app switcher",
  "type": "module",
  "sideEffects": false,
  "files": [
    "src",
    "!src/**/*.test.{ts,tsx}",
    "tsconfig.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    "./middleware": "./src/entries/middleware.ts",
    "./config": "./src/entries/config.ts",
    "./components/BrandSwitcher": "./src/entries/components/BrandSwitcher.ts",
    "./components/TenantTheme": "./src/entries/components/TenantTheme.ts",
    "./auth/oidc-config": "./src/entries/auth/oidc-config.ts",
    "./auth/oidc-cookie": "./src/entries/auth/oidc-cookie.ts",
    "./auth/can-access": "./src/entries/auth/can-access.ts",
    "./auth/oidc-refresh": "./src/entries/auth/oidc-refresh.ts",
    "./auth/nextauth-strategy": "./src/entries/auth/nextauth-strategy.ts",
    "./api/oidc-signin": "./src/entries/api/oidc-signin.ts",
    "./api/oidc-callback": "./src/entries/api/oidc-callback.ts",
    "./api/oidc-signout": "./src/entries/api/oidc-signout.ts",
    "./api/shell-info": "./src/entries/api/shell-info.ts",
    "./package.json": "./package.json",
    "./components/ServiceIcon": "./src/entries/components/ServiceIcon.ts",
    "./notifications/notifier": "./src/entries/notifications/notifier.ts",
    "./settings": "./src/entries/settings.ts",
    "./directory": "./src/entries/directory.ts",
    "./notifications/blocks": "./src/entries/notifications/blocks.ts",
    "./components/NotificationBell": "./src/entries/components/NotificationBell.ts",
    "./components/ImpersonationCapsule": "./src/entries/components/ImpersonationCapsule.ts",
    "./core": "./src/core/index.ts",
    "./next": "./src/next/index.ts",
    "./payload": "./src/payload/index.ts",
    "./react": "./src/react/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "jose": "^5.10.0",
    "oauth4webapi": "^3.6.0"
  },
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "next": "^15.4.0",
    "payload": "^3.79.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "lucide-react": "^0.500.0",
    "next": "^15.4.0",
    "payload": "^3.79.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "peerDependenciesMeta": {
    "lucide-react": {
      "optional": false
    }
  }
}
